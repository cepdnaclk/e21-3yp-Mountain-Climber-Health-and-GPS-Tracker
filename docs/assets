---
@import "{{ site.theme }}";

/* Make the background slightly dark/modern */
body {
  background-color: #0f172a;
  color: #f8fafc;
}

/* Make links pop with teal */
a {
  color: #2dd4bf;
}

/* Style the tables to look like a modern dashboard */
table {
  background-color: #1e293b;
  border-radius: 8px;
}
th {
  background-color: #334155;
  color: white;
}
